  <script>
    // 指定プラットフォームのタブ/パネルを active にする（event 非依存）。
    function activatePlatform(lang, id) {
      var scope = document.querySelector('.lang-' + lang);
      if (!scope) return;
      var targetTab = 'tab-' + lang + '-' + id;
      scope.querySelectorAll('.platform-tab').forEach(function(el) {
        var isTarget = el.getAttribute('aria-controls') === targetTab;
        el.classList.toggle('active', isTarget);
        el.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });
      scope.querySelectorAll('.platform-content').forEach(function(el) {
        el.classList.toggle('active', el.id === targetTab);
      });
    }
    function switchTab(lang, id, event) {
      if (event) event.preventDefault();
      activatePlatform(lang, id);
    }
    // Windows 主力配布: 訪問者の OS が Windows なら Windows タブを既定表示にする。
    // macOS / Linux 訪問者は既定の macOS/Linux タブのまま（双方の導線を最短化）。
    document.addEventListener('DOMContentLoaded', function() {
      var ua = navigator.userAgent || navigator.platform || '';
      if (/Windows|Win64|Win32|WOW64/i.test(ua)) {
        ['ja', 'en'].forEach(function(lang) { activatePlatform(lang, 'win'); });
      }
    });
  </script>
